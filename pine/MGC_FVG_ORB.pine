i_s8Desde   = input.float(70.5, "Inicio del bloque OTE (% de retroceso)", minval = 50.0, maxval = 95.0, step = 0.5, group = G_S8)
i_s8Hasta   = input.float(79.0, "Fin del bloque OTE (% de retroceso)",    minval = 50.0, maxval = 99.0, step = 0.5, group = G_S8,
