i_s8Obj     = input.string("R fijo", "Objetivo de S8", options = ["R fijo", "Extremo del tramo"], group = G_S8)
i_s8R       = input.float(2.0, "R fijo del objetivo", minval = 0.5, maxval = 10.0, step = 0.1, group = G_S8)

const string G_REG = "Régimen de mercado"
i_clasReg   = input.string("Rango del día / ATR", "Clasificador tendencia-rango",
     options = ["Rango del día / ATR", "ADX", "Persistencia respecto al VWAP"], group = G_REG,
